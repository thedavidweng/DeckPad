{
  "name": "deckpad",
  "version": "0.0.1",
  "description": "Use your Steam Deck as a Bluetooth game controller for another device (Decky Loader plugin)",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -t . -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedavidweng/DeckPad.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "bluetooth",
    "controller",
    "gamepad"
  ],
  "author": "thedavidweng",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/thedavidweng/DeckPad/issues"
  },
  "homepage": "https://github.com/thedavidweng/DeckPad#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@rollup/rollup-linux-x64-musl": "^4.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "rollup": "^4.64.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
